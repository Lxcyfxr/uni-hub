{
  "name": "uni-hub",
  "version": "0.1.0",
  "description": "Uni-Hub: Studienorganisation mit Kalender, To-Do, Lernplaner, Anki, Doc-Hub und Web-Diensten",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run dist:win",
    "pack": "npm run pack:win",
    "dist:win": "node scripts/licenses.js && electron-vite build && electron-builder --config config/electron-builder.win.json --win nsis && node scripts/checksums.mjs",
    "pack:win": "electron-vite build && electron-builder --config config/electron-builder.win.json --win dir",
    "dist:linux": "node scripts/licenses.js && electron-vite build && electron-builder --config config/electron-builder.linux.json --linux",
    "pack:linux": "electron-vite build && electron-builder --config config/electron-builder.linux.json --linux dir",
    "dist:mac": "node scripts/licenses.js && electron-vite build && electron-builder --config config/electron-builder.mac.json --mac",
    "pack:mac": "electron-vite build && electron-builder --config config/electron-builder.mac.json --mac dir",
    "test": "vitest run",
    "licenses": "node scripts/licenses.js",
    "selftest": "electron-vite build && electron . --selftest=selftest-result.json",
    "budget": "node scripts/check-budget.mjs",
    "test:electron": "node scripts/test-electron.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "ts-fsrs": "^5.4.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "node-ical": "^0.27.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "author": "Lxcyfxr",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lxcyfxr/uni-hub.git"
  },
  "homepage": "https://github.com/Lxcyfxr/uni-hub#readme",
  "bugs": {
    "url": "https://github.com/Lxcyfxr/uni-hub/issues"
  }
}
